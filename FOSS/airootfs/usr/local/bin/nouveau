#!/usr/bin/env bash

echo "Blacklisting Nouveau"

if [ -f /etc/default/grub ]; then

        if ! grep -q "modprobe.blacklist=nouveau" /etc/default/grub; then

                if grep -q "^GRUB_CMDLINE_LINUX_DEFAULT=\".*\"" /etc/default/grub; then
                        # Handles double quotes
                        sed -i "/^GRUB_CMDLINE_LINUX_DEFAULT=/s/\"$/ nowatchdog loglevel=3 nvme_load=yes modprobe.blacklist=nouveau\"/" /etc/default/grub
                elif grep -q "^GRUB_CMDLINE_LINUX_DEFAULT='.*'" /etc/default/grub; then
                        # Handles single quotes
                        sed -i "/^GRUB_CMDLINE_LINUX_DEFAULT=/s/'$/ nowatchdog loglevel=3 nvme_load=yes modprobe.blacklist=nouveau'/" /etc/default/grub
                fi

                echo "Updating Grub"

                grub-mkconfig -o /boot/grub/grub.cfg
        else
                echo "Nouveau already blacklisted, skipping."
        fi

fi

rm /usr/local/bin/nouveau
